# Local tooling artifacts (not part of source)
.claude/
.local/
# Per-platform bench baselines are runtime output, not source.
# bench/baseline.txt is the historical Linux reference (committed
# before this rule landed); new baselines should be regenerated by
# running the bench and consumed by check-regression.sh, not diffed
# against a static file. See bench/run_all.sh / bench/run_all_mac.sh.
#
# Exception: the Windows bench regression gate (bench/check-regression.ps1)
# compares against a committed static baseline — one per event type,
# because GitHub Actions runs pull_request and push/schedule on
# measurably different runner hardware. They are refreshed by hand
# from a real run's artifact (Issue #687).
bench/baseline-*.txt
!bench/baseline-windows.txt
!bench/baseline-windows-pr.txt
bench/__pycache__/
